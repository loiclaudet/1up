{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "1up",
  "mainBinaryName": "1up",
  "version": "0.1.0",
  "identifier": "com.loiclaudet.oneup",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "1up",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "turns nintendo pads into xbox pads on windows",
    "publisher": "Loïc Laudet",
    "homepage": "https://github.com/loiclaudet/1up",
    "copyright": "MIT, Loïc Laudet"
  }
}
